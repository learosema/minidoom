# Copy to .env.local (already gitignored) and fill in one provider block.
# Dagger picks the provider automatically based on which vars are present.

# ── Anthropic Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5   # optional, this is the default

# ── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o                 # optional, gpt-4o is the default

# ── Any OpenAI-compatible endpoint (e.g. LM Studio, vLLM, Mistral AI) ───────
# OPENAI_BASE_URL=http://localhost:1234/v1/
# OPENAI_API_KEY=not-needed           # some servers require a non-empty value
# OPENAI_MODEL=mistral-small-latest

# ── Ollama (local, no API key required) ──────────────────────────────────────
# OPENAI_BASE_URL=http://localhost:11434/v1/   # trailing slash is mandatory
# OPENAI_MODEL=qwen2.5-coder:7b
